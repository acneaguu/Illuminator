{
  "packs": [
    {
      "id": "grid_congestion",
      "title": "Grid Congestion",
      "subtitle": "How much can a neighbourhood's connection to the grid take before it strains?",
      "cases": [
        {
          "id": "conventional",
          "title": "Base case: conventional supply",
          "description": "Every house draws its electricity straight from the grid. The neighbourhood's connection has a fixed capacity -- how close does an ordinary day come to it?",
          "kind": "dataset",
          "scenario": null,
          "baseline": {
            "file": "load_data.txt",
            "value_column": "load",
            "scale_by": "houses",
            "scale": "raw",
            "unit": "kW",
            "label": "Load on the connection",
            "title": "Load on the grid connection",
            "bands": {
              "cap": 15,
              "tol": 0.67,
              "crit": 0.9
            }
          },
          "day": {
            "default": "2012-02-01",
            "min": "2012-01-01",
            "max": "2012-12-30",
            "presets": {
              "Winter": "2012-02-01",
              "Summer": "2012-07-06"
            }
          },
          "controls_heading": "Neighbourhood",
          "controls": [
            {
              "id": "houses",
              "label": "Houses in the neighbourhood",
              "type": "slider",
              "min": 1,
              "max": 30,
              "step": 1,
              "default": 10,
              "targets": []
            }
          ],
          "states": [],
          "charts": [],
          "monitor_items": [],
          "summary": {},
          "defaults": {
            "day": "2012-02-01",
            "settings": {
              "houses": 10
            },
            "states": {}
          }
        },
        {
          "id": "renewables",
